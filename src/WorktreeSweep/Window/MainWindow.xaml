<Window
  x:Class="WorktreeSweep.Window.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:WorktreeSweep.Window"
  Width="1100"
  Height="700"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <local:EnumVisibilityConverter x:Key="ShownOn" />
    <local:RiskBrushConverter x:Key="RiskBrush" />

    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- A line of text that takes no room while it has none. -->
    <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ButtonRow" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="MergeCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding MergeRisk, Converter={StaticResource RiskBrush}}" />
    </Style>
    <Style x:Key="DirtyCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding DirtyRisk, Converter={StaticResource RiskBrush}}" />
    </Style>
    <Style x:Key="UpstreamCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding UpstreamRisk, Converter={StaticResource RiskBrush}}" />
    </Style>

    <!-- The answer the question defaults to is the button Enter presses. -->
    <Style x:Key="YesButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding DefaultAnswer}" Value="True">
          <Setter Property="IsDefault" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding DefaultAnswer}" Value="False">
          <Setter Property="IsDefault" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <!-- Scanning -->
    <StackPanel VerticalAlignment="Center" Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Scanning}">
      <TextBlock x:Name="ScanningText" HorizontalAlignment="Center" />
      <ProgressBar Width="400" Height="16" Margin="0,10,0,0" IsIndeterminate="True" />
    </StackPanel>

    <!-- Empty -->
    <StackPanel Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Empty}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <StackPanel Style="{StaticResource ButtonRow}">
        <Button Content="Close" Click="OnCloseClick" />
      </StackPanel>
    </StackPanel>

    <!-- Failed -->
    <StackPanel Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Failed}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <StackPanel Style="{StaticResource ButtonRow}">
        <Button Content="Close" Click="OnCloseClick" />
      </StackPanel>
    </StackPanel>

    <!-- List -->
    <Grid Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=List}">
      <DockPanel DataContext="{Binding List}">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="{Binding Header}" />
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonRow}">
          <Button Content="Tick all" Command="{Binding TickAllCommand}" />
          <Button Content="Tick none" Command="{Binding TickNoneCommand}" />
          <Button Content="Review" Command="{Binding ReviewCommand}" IsDefault="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HiddenWhenEmpty}" Text="{Binding Message}" />
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="6" BorderBrush="LightGray" BorderThickness="1">
          <ItemsControl FontFamily="Consolas" ItemsSource="{Binding Detail}" />
        </Border>
        <DataGrid
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          ItemsSource="{Binding Rows}"
          SelectedItem="{Binding Selected}"
          SelectionMode="Single"
        >
          <DataGrid.Columns>
            <DataGridTemplateColumn>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsTicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" />
            <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" />
            <DataGridTextColumn Header="Branch" Binding="{Binding Branch, Mode=OneWay}" />
            <DataGridTextColumn Header="Merge" Binding="{Binding Merge, Mode=OneWay}" ElementStyle="{StaticResource MergeCell}" />
            <DataGridTextColumn Header="Dirty" Binding="{Binding Dirty, Mode=OneWay}" ElementStyle="{StaticResource DirtyCell}" />
            <DataGridTextColumn Header="Upstream" Binding="{Binding Upstream, Mode=OneWay}" ElementStyle="{StaticResource UpstreamCell}" />
            <DataGridTextColumn Header="Active" Binding="{Binding Active, Mode=OneWay}" />
            <DataGridTextColumn Header="Size" Binding="{Binding Size, Mode=OneWay}" />
            <DataGridTextColumn Header="Flags" Binding="{Binding Flags, Mode=OneWay}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>

    <!-- Review -->
    <Grid Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Review}">
      <Grid DataContext="{Binding Review}">
        <TextBlock
          Text="Reading the Recycle Bin sizes…"
          Visibility="{Binding State, Converter={StaticResource ShownOn}, ConverterParameter=Preparing}"
        />

        <StackPanel Visibility="{Binding State, Converter={StaticResource ShownOn}, ConverterParameter=Asking}">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
          <TextBlock Margin="0,6,0,0" FontFamily="Consolas" Text="{Binding PickPath}" />
          <TextBlock Margin="0,10,0,0" Text="{Binding Body}" TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0" Text="{Binding Question}" TextWrapping="Wrap" />
          <StackPanel Style="{StaticResource ButtonRow}">
            <Button Content="{Binding YesLabel}" Command="{Binding AnswerYesCommand}" Style="{StaticResource YesButton}" />
            <Button Content="{Binding NoLabel}" Command="{Binding AnswerNoCommand}" Style="{StaticResource NoButton}" />
            <Button Content="Back" Command="{Binding BackCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding State, Converter={StaticResource ShownOn}, ConverterParameter=Confirming}">
          <TextBlock Text="{Binding FinalSentence}" TextWrapping="Wrap" />
          <StackPanel Style="{StaticResource ButtonRow}">
            <Button Content="Remove" Command="{Binding ConfirmCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" IsDefault="True" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Removing -->
    <Grid Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Removing}">
      <DockPanel DataContext="{Binding Removing}">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="16" Text="{Binding Heading}" />
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonRow}">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HiddenWhenEmpty}" Text="{Binding Banner}" />
        <TextBlock DockPanel.Dock="Bottom" FontWeight="SemiBold" Style="{StaticResource HiddenWhenEmpty}" Text="{Binding Notice}" />
        <DataGrid
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          ItemsSource="{Binding Rows}"
        >
          <DataGrid.Columns>
            <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>

    <!-- Results -->
    <Grid Visibility="{Binding Screen, Converter={StaticResource ShownOn}, ConverterParameter=Results}">
      <DockPanel DataContext="{Binding Results}">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Style="{StaticResource HiddenWhenEmpty}" Text="{Binding Banner}" />
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonRow}">
          <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Total}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl FontFamily="Consolas" ItemsSource="{Binding Lines}" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
